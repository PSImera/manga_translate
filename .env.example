# --- LLM Provider ---
# The provider is determined automatically based on which *_API_KEY is set (with OpenAI taking priority).
# You can also specify it explicitly: LLM_PROVIDER=openai|anthropic|google|grok
# LLM_PROVIDER=

# Default: OpenAI-compatible client (for a local model running in LM Studio)
MODEL=google/gemma-4-e4b
OPENAI_API_BASE=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lmstudio

# External OpenAI-compatible API (alternative to a local model):
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# MODEL=gpt-5.5

# Anthropic (requires package: uv sync --extra anthropic):
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-4-6

# Google Gemini (requires package: uv sync --extra google):
# GOOGLE_API_KEY=...
# MODEL=gemini-2.0-flash

# Grok / xAI (OpenAI-compatible; no extra package required):
# XAI_API_KEY=xai-...
# MODEL=grok-2-latest

# --- Path to detection model ---
YOLO_WEIGHTS=models/bubbles_detect/bubbles_detect.pt

# Use this to offload detection to the CPU and free up GPU resources
# OCR_DEVICE=cpu
