# --- LLM-провайдер ---
# Провайдер определяется автоматически по тому, какой *_API_KEY задан (приоритет — openai).
# Можно задать явно: LLM_PROVIDER=openai|anthropic|google|grok
# LLM_PROVIDER=

# По умолчанию — OpenAI-совместимый клиент (локальная модель в LM Studio)
MODEL=google/gemma-4-e4b
OPENAI_API_BASE=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lmstudio

# Внешний OpenAI-совместимый API (альтернатива локальной модели):
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# MODEL=gpt-5.5

# Anthropic (нужен пакет: uv sync --extra anthropic):
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-4-6

# Google Gemini (нужен пакет: uv sync --extra google):
# GOOGLE_API_KEY=...
# MODEL=gemini-2.0-flash

# Grok / xAI (OpenAI-совместимый, extra не нужен):
# XAI_API_KEY=xai-...
# MODEL=grok-2-latest

# --- Пути к моделям ---
YOLO_WEIGHTS=models/yolo/bubbles_detect_v1.pt

# если надо перевести распознавание на cpu и разгрузить gpu
# OCR_DEVICE=cpu
